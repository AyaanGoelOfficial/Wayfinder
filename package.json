{
  "name": "wayfinder-gn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "acceptance": "tsx scripts/acceptance.ts",
    "audit:epe": "tsx scripts/audit-epe.ts",
    "audit:tolls": "tsx scripts/audit-tolls.ts",
    "bench": "tsx scripts/bench.ts",
    "build-city": "tsx packages/pipeline/build-city.ts",
    "calibrate:quality": "tsx scripts/calibrate-quality.ts",
    "calibrate:speeds": "tsx scripts/calibrate-speeds.ts",
    "derive:bbox": "tsx scripts/derive-bbox.ts",
    "dev": "npm --prefix packages/client run dev",
    "diagnose:boundary": "tsx scripts/diagnose-boundary.ts",
    "diagnose:flattening": "tsx scripts/diagnose-flattening.ts",
    "diagnose:route": "tsx scripts/diagnose-divergence.ts",
    "experiment:objective": "tsx scripts/experiment-objective.ts",
    "experiment:speeds": "tsx scripts/experiment-speeds.ts",
    "experiment:turns": "tsx scripts/experiment-turns.ts",
    "fetch:extracts": "tsx scripts/fetch-extracts.ts",
    "gate": "npm run typecheck && npm run test && npm run gate:copy && npm run gate:mutation",
    "gate:copy": "tsx scripts/gate-copy.ts",
    "gate:equality": "tsx scripts/gate-equality.ts",
    "gate:fixtures": "tsx scripts/gate-fixtures.ts",
    "gate:mutation": "tsx scripts/gate-compound-assign.ts",
    "gate:oracle": "tsx scripts/gate-oracle.ts",
    "make:fixture": "tsx scripts/make-pbf-fixture.ts",
    "probe:extracts": "tsx scripts/probe-extract.ts",
    "profile:route": "tsx scripts/profile-route.ts",
    "serve": "tsx packages/server/main.ts",
    "setup:tools": "tsx scripts/setup-tools.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck:client",
    "typecheck:client": "npm --prefix packages/client run typecheck",
    "validate": "tsx scripts/validate-osrm.ts",
    "verify:browser": "tsx scripts/verify-browser.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "fastify": "^5.10.0",
    "opentype.js": "^2.0.0",
    "pmtiles": "^4.4.1"
  }
}
